generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  FRONT_DESK
  ACCOUNTANT
  GUEST
}

enum SessionAudience {
  FRONTEND
  DASHBOARD
}

enum PropertyAssignmentRole {
  ADMIN
  MANAGER
  FRONT_DESK
  ACCOUNTANT
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum TenantStatus {
  ACTIVE
  INACTIVE
}

enum UnitStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum RoomProductCategory {
  NIGHTLY
  LONG_STAY
  CORPORATE
}

enum ComfortOption {
  AC
  NON_AC
}

enum RateType {
  NIGHTLY
  WEEKLY
  MONTHLY
}

enum PricingTier {
  STANDARD
  CORPORATE
  SEASONAL
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum TaxType {
  PERCENTAGE
  FIXED
}

enum TaxCategory {
  GENERIC
  GST
}

enum TaxScope {
  BOOKING
  ACCOMMODATION
}

enum TaxTargetType {
  ALL
  ROOM
  UNIT
}

enum TaxCalculationMode {
  FLAT
  SLAB_PER_ITEM_NIGHTLY_TARIFF
}

enum TaxDiscountTreatment {
  BEFORE_TAX
}

enum BookingTargetType {
  ROOM
  UNIT
}

enum BookingType {
  SINGLE_TARGET
  MULTI_ROOM
}

enum BookingSource {
  PUBLIC
  WALK_IN
  CORPORATE
  GROUP
}

enum PropertyAuditEntityType {
  PROPERTY
  UNIT
  ROOM
  PRICING
  TAX
  MAINTENANCE
  ENQUIRY
  QUOTE
  COMPANY
  BOOKING_GROUP
  GROUP_FOLIO
  BILLING_DOCUMENT
  DAILY_CLOSE
}

enum PropertyAuditAction {
  CREATED
  UPDATED
  DELETED
  STATUS_CHANGED
  VOIDED
  CONVERTED
  RETRIED
  DEAD_LETTERED
}

enum BookingGroupStatus {
  PROSPECT
  TENTATIVE
  CONFIRMED
  IN_HOUSE
  COMPLETED
  CANCELLED
}

enum GroupFolioChargeStatus {
  ACTIVE
  VOID
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum BookingPaymentPolicy {
  TOKEN_AT_BOOKING
  NO_UPFRONT_PAYMENT
}

enum AdvancePaymentType {
  NONE
  FIXED_AMOUNT
  PERCENTAGE
}

enum BookingPaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum PaymentProvider {
  MANUAL
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum BookingRefundRequestStatus {
  REQUESTED
  IN_REVIEW
  REJECTED
  FULFILLED
  CANCELLED
}

enum PaymentPurpose {
  TOKEN
  BALANCE
  FULL_PAYMENT
}

enum PaymentMethod {
  CASH
  UPI_MANUAL
  BANK_TRANSFER
  CARD_POS
  MANUAL
  ONLINE_GATEWAY
}

enum BillingDocumentType {
  INVOICE
  RECEIPT
  CREDIT_NOTE
  DEBIT_NOTE
}

enum BillingDocumentStatus {
  DRAFT
  ISSUED
  CANCELLED
  VOID
}

enum SideEffectJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum EmailDeliveryType {
  PASSWORD_RESET
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationEventKey {
  BOOKING_CREATED
  BOOKING_CANCELLED
  PAYMENT_SUCCEEDED
  REFUND_SUCCEEDED
  USER_REGISTERED
  BOOKING_CHECKED_IN
  BOOKING_CHECKED_OUT
}

enum NotificationSettingScope {
  GLOBAL
  PROPERTY
}

enum NotificationSettingState {
  USE_GLOBAL
  ENABLED
  DISABLED
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum MaintenanceTargetType {
  PROPERTY
  UNIT
  ROOM
}

enum RoomHousekeepingStatus {
  DIRTY
  CLEANING
  CLEAN
  INSPECTED
}

enum BookingOperationEventType {
  CHECK_IN
  CHECK_OUT
  NO_SHOW
  ROOM_ASSIGNMENT
  ROOM_MOVE
  STATUS_CORRECTION
  BALANCE_OVERRIDE
  MAINTENANCE_CONFLICT
  FOLIO_CHARGE
  FOLIO_CHARGE_VOID
  STAY_EXTENSION
}

enum BookingRoomAllocationSource {
  BOOKING_CREATED
  ROOM_ASSIGNED
  CHECK_IN_ASSIGNED
  ROOM_MOVE
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum PropertyClosureType {
  HOLIDAY_CLOSURE
  OWNER_BLOCK
}

enum PropertyClosureStatus {
  ACTIVE
  CANCELLED
}

enum FolioChargeType {
  INCIDENTAL
  PENALTY
  EXTENSION
  ADJUSTMENT
}

enum FolioChargeStatus {
  ACTIVE
  VOID
}

/**
 * =========================
 * USER & AUTH
 * =========================
 */

model User {
  id       String @id @default(uuid())
  fullName String
  email    String @unique

  countryCode   String? @db.VarChar(8)
  contactNumber String? @db.VarChar(20)

  createdByUserId String?
  passwordHash    String
  role            UserRole @default(GUEST)

  createdBy                  User?                      @relation("UserCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdUsers               User[]                     @relation("UserCreator")
  sessions                   Session[]
  resetTokens                PasswordResetToken[]
  emailDeliveryJobs          EmailDeliveryJob[]
  bookings                   Booking[]
  bookingRefundRequests      BookingRefundRequest[]
  reviewedRefundRequests     BookingRefundRequest[]     @relation("RefundRequestReviewedBy")
  payments                   Payment[]
  refunds                    PaymentRefund[]
  paymentsReceived           Payment[]                  @relation("PaymentReceivedBy")
  bookingStatusHistory       BookingStatusHistory[]     @relation("BookingStatusActor")
  quotes                     QuoteRequest[]
  propertyAssignments        PropertyAssignment[]       @relation("AssignedUser")
  createdPropertyAssignments PropertyAssignment[]       @relation("AssignmentCreatedBy")
  createdProperties          Property[]                 @relation("PropertyCreatedBy")
  createdMaintenanceBlocks   MaintenanceBlock[]         @relation("MaintenanceCreatedBy")
  assignedMaintenanceBlocks  MaintenanceBlock[]         @relation("MaintenanceAssignedTo")
  createdPropertyClosures    PropertyClosure[]          @relation("PropertyClosureCreatedBy")
  cancelledPropertyClosures  PropertyClosure[]          @relation("PropertyClosureCancelledBy")
  bookingOperationEvents     BookingOperationEvent[]
  housekeepingEvents         RoomHousekeepingEvent[]
  createdFolioCharges        BookingFolioCharge[]       @relation("FolioChargeCreatedBy")
  voidedFolioCharges         BookingFolioCharge[]       @relation("FolioChargeVoidedBy")
  notificationSettingAudits  NotificationSettingAudit[]
  bookingPolicyAudits        BookingPolicyAudit[]
  billingSettingAudits       BillingSettingAudit[]
  bookingRoomAllocations     BookingRoomAllocation[]    @relation("BookingRoomAllocationActor")
  propertyDailyCloses        PropertyDailyClose[]       @relation("PropertyDailyCloseActor")
  propertyAuditEvents        PropertyAuditEvent[]       @relation("PropertyAuditActor")
  createdCompanies           CompanyAccount[]           @relation("CompanyCreatedBy")
  createdBookingGroups       BookingGroup[]             @relation("BookingGroupCreatedBy")
  groupFolioChargesCreated   GroupFolioCharge[]         @relation("GroupFolioCreatedBy")
  groupFolioChargesVoided    GroupFolioCharge[]         @relation("GroupFolioVoidedBy")

  isActive           Boolean @default(true)
  mustChangePassword Boolean @default(false)

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  leadStatusHistories LeadStatusHistory[]

  @@map("users")
}

model Session {
  id           String          @id @default(uuid())
  userId       String
  refreshToken String          @unique @db.VarChar(512)
  audience     SessionAudience @default(DASHBOARD)
  ip           String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([audience])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model EmailDeliveryJob {
  id                  String              @id @default(uuid())
  type                EmailDeliveryType
  status              SideEffectJobStatus @default(PENDING)
  userId              String
  recipient           String
  appUrl              String
  tokenTtlMinutes     Int                 @default(15)
  attemptCount        Int                 @default(0)
  maxAttempts         Int                 @default(3)
  lastError           String?             @db.Text
  correlationId       String?             @db.VarChar(128)
  processingStartedAt DateTime?
  nextAttemptAt       DateTime?
  deadLetteredAt      DateTime?
  sentAt              DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@index([userId, createdAt])
  @@map("email_delivery_jobs")
}

model NotificationGlobalSetting {
  id        String               @id @default(uuid())
  eventKey  NotificationEventKey
  channel   NotificationChannel
  enabled   Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([eventKey, channel])
  @@map("notification_global_settings")
}

model PropertyNotificationOverride {
  id         String                   @id @default(uuid())
  propertyId String
  eventKey   NotificationEventKey
  channel    NotificationChannel
  state      NotificationSettingState
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, eventKey, channel])
  @@index([propertyId])
  @@map("property_notification_overrides")
}

model NotificationSettingAudit {
  id            String                    @id @default(uuid())
  actorUserId   String
  scope         NotificationSettingScope
  propertyId    String?
  eventKey      NotificationEventKey
  channel       NotificationChannel
  previousState NotificationSettingState?
  nextState     NotificationSettingState
  correlationId String?                   @db.VarChar(128)
  createdAt     DateTime                  @default(now())

  actor    User      @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([propertyId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("notification_setting_audits")
}

model NotificationDeliveryJob {
  id                  String               @id @default(uuid())
  idempotencyKey      String               @unique @db.VarChar(191)
  eventKey            NotificationEventKey
  channel             NotificationChannel
  propertyId          String?
  recipient           String
  payload             Json
  status              SideEffectJobStatus  @default(PENDING)
  attemptCount        Int                  @default(0)
  maxAttempts         Int                  @default(3)
  lastError           String?              @db.Text
  providerMessageId   String?
  correlationId       String?              @db.VarChar(128)
  processingStartedAt DateTime?
  nextAttemptAt       DateTime?
  deadLetteredAt      DateTime?
  sentAt              DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([propertyId, createdAt])
  @@index([eventKey, createdAt])
  @@map("notification_delivery_jobs")
}

/**
 * =========================
 * INVENTORY
 * =========================
 */

model Tenant {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique
  primaryDomain   String?      @unique
  status          TenantStatus @default(ACTIVE)
  brandName       String
  logoUrl         String?
  primaryColor    String       @default("#4f46e5")
  secondaryColor  String       @default("#f59e0b")
  supportEmail    String?
  supportPhone    String?
  defaultCurrency String       @default("INR")
  timezone        String       @default("Asia/Kolkata")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties       Property[]
  billingDocuments BillingDocument[]

  @@map("tenants")
}

model Property {
  id              String   @id @default(uuid())
  tenantId        String
  slug            String
  name            String
  address         String
  city            String
  state           String
  createdByUserId String
  supportEmail    String?
  supportPhone    String?
  latitude        Decimal? @db.Decimal(10, 7)
  longitude       Decimal? @db.Decimal(10, 7)

  isActive Boolean        @default(true)
  status   PropertyStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                    Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy                 User                           @relation("PropertyCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  units                     Unit[]
  amenities                 PropertyAmenity[]
  roomProducts              RoomProduct[]
  roomPricing               RoomPricing[]
  bookings                  Booking[]
  bookingPolicy             PropertyBookingPolicy?
  bookingRefundRequests     BookingRefundRequest[]
  inventoryLocks            InventoryLock[]
  payments                  Payment[]
  refunds                   PaymentRefund[]
  quoteRequests             QuoteRequest[]
  enquiries                 Enquiry[]
  assignments               PropertyAssignment[]
  maintenanceBlocks         MaintenanceBlock[]
  propertyClosures          PropertyClosure[]
  bookingOperationEvents    BookingOperationEvent[]
  folioCharges              BookingFolioCharge[]
  housekeepingEvents        RoomHousekeepingEvent[]
  taxes                     Tax[]
  coupons                   Coupon[]
  galleries                 Gallery[]
  billingSetting            BillingSetting?
  billingDocuments          BillingDocument[]
  notificationOverrides     PropertyNotificationOverride[]
  notificationSettingAudits NotificationSettingAudit[]
  notificationDeliveryJobs  NotificationDeliveryJob[]
  bookingPolicyAudits       BookingPolicyAudit[]
  billingSettingAudits      BillingSettingAudit[]
  bookingRoomAllocations    BookingRoomAllocation[]
  dailyCloses               PropertyDailyClose[]
  auditEvents               PropertyAuditEvent[]
  companies                 CompanyAccount[]
  bookingGroups             BookingGroup[]
  groupFolioCharges         GroupFolioCharge[]
  billingSequences          BillingDocumentSequence[]

  @@unique([tenantId, name, city, state])
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("properties")
}

model PropertyDailyClose {
  id              String   @id @default(uuid())
  propertyId      String
  businessDate    DateTime @db.Date
  closedByUserId  String
  paymentCount    Int
  paymentTotal    Decimal  @db.Decimal(12, 2)
  refundCount     Int
  refundTotal     Decimal  @db.Decimal(12, 2)
  netPaymentTotal Decimal  @db.Decimal(12, 2)
  bookingsCreated Int
  checkIns        Int
  checkOuts       Int
  noShows         Int
  note            String?  @db.VarChar(500)
  closedAt        DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  closedBy User     @relation("PropertyDailyCloseActor", fields: [closedByUserId], references: [id], onDelete: Restrict)

  @@unique([propertyId, businessDate])
  @@index([closedByUserId, closedAt])
  @@map("property_daily_closes")
}

model PropertyAuditEvent {
  id            String                  @id @default(uuid())
  propertyId    String
  actorUserId   String?
  entityType    PropertyAuditEntityType
  entityId      String
  action        PropertyAuditAction
  reason        String?                 @db.VarChar(500)
  previousData  Json?
  nextData      Json?
  metadata      Json?
  correlationId String?                 @db.VarChar(128)
  createdAt     DateTime                @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  actor    User?    @relation("PropertyAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([propertyId, createdAt])
  @@index([propertyId, entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("property_audit_events")
}

model PropertyBookingPolicy {
  id                          String             @id @default(uuid())
  propertyId                  String             @unique
  advancePaymentType          AdvancePaymentType @default(FIXED_AMOUNT)
  advancePaymentValue         Decimal            @default(10)
  tokenRefundable             Boolean            @default(false)
  checkInTime                 String             @default("12:00")
  checkOutTime                String             @default("11:00")
  pendingPaymentExpiryMinutes Int                @default(15)
  cancellationRules           Json
  refundRules                 Json
  earlyCheckInRules           Json?
  earlyCheckoutRules          Json
  lateCheckoutRules           Json?
  downgradeRules              Json?
  noShowRules                 Json
  guestPolicyText             String             @db.Text
  version                     Int                @default(1)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  property Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  audits   BookingPolicyAudit[]

  @@map("property_booking_policies")
}

model BookingPolicyAudit {
  id           String   @id @default(uuid())
  policyId     String
  propertyId   String
  actorUserId  String
  version      Int
  previousData Json
  nextData     Json
  createdAt    DateTime @default(now())

  policy   PropertyBookingPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  property Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  actor    User                  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([propertyId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("booking_policy_audits")
}

model Unit {
  id         String @id @default(uuid())
  propertyId String
  unitNumber String
  floor      Int

  isActive Boolean    @default(true)
  status   UnitStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property          Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms             Room[]
  pricing           RoomPricing[]
  amenities         UnitAmenity[]
  maintenanceBlocks MaintenanceBlock[]
  galleries         Gallery[]

  @@unique([propertyId, unitNumber])
  @@index([propertyId])
  @@map("units")
}

model Room {
  id                 String                 @id @default(uuid())
  unitId             String
  name               String
  number             String
  hasAC              Boolean                @default(false)
  maxOccupancy       Int                    @default(2)
  status             RoomStatus             @default(AVAILABLE)
  housekeepingStatus RoomHousekeepingStatus @default(INSPECTED)
  isActive           Boolean                @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  amenities              RoomAmenity[]
  pricing                RoomPricing[]
  maintenanceBlocks      MaintenanceBlock[]
  housekeepingEvents     RoomHousekeepingEvent[]
  bookingRoomAllocations BookingRoomAllocation[]
  galleries              Gallery[]

  @@unique([unitId, number])
  @@index([unitId])
  @@map("rooms")
}

/**
 * =========================
 * PRODUCTS & PRICING
 * =========================
 */

model RoomProduct {
  id         String              @id @default(uuid())
  propertyId String
  name       String
  occupancy  Int
  hasAC      Boolean
  category   RoomProductCategory

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  pricing  RoomPricing[]
  quotes   QuoteRequest[]

  @@unique([propertyId, name])
  @@index([propertyId])
  @@map("room_products")
}

model RoomPricing {
  id           String      @id @default(uuid())
  propertyId   String
  roomId       String?
  unitId       String?
  productId    String
  rateType     RateType    @default(NIGHTLY)
  pricingTier  PricingTier @default(STANDARD)
  minNights    Int         @default(1)
  maxNights    Int?
  taxInclusive Boolean     @default(false)
  price        Decimal
  validFrom    DateTime
  validTo      DateTime?
  createdAt    DateTime    @default(now())

  property Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room?       @relation(fields: [roomId], references: [id], map: "fk_room_pricing_room")
  unit     Unit?       @relation(fields: [unitId], references: [id], map: "fk_room_pricing_unit")
  product  RoomProduct @relation(fields: [productId], references: [id], map: "fk_room_pricing_product")

  @@index([propertyId])
  @@index([roomId])
  @@index([unitId])
  @@index([productId])
  @@index([validFrom, validTo])
  @@map("room_pricing")
}

/**
 * =========================
 * QUOTES & BOOKINGS
 * =========================
 */

model QuoteRequest {
  id                 String            @id @default(uuid())
  propertyId         String
  userId             String?
  productId          String?
  targetType         BookingTargetType
  unitId             String?
  roomId             String?
  guestName          String?
  guestEmail         String?
  guestContactNumber String?
  companyName        String?
  guestCount         Int               @default(1)
  comfortOption      ComfortOption?
  quoteSnapshot      Json?
  expiresAt          DateTime?
  convertedBookingId String?           @unique

  checkIn  DateTime
  checkOut DateTime
  status   LeadStatus @default(NEW)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property         Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user             User?               @relation(fields: [userId], references: [id], map: "fk_quote_user")
  product          RoomProduct?        @relation(fields: [productId], references: [id], map: "fk_quote_product")
  convertedBooking Booking?            @relation("QuoteConvertedBooking", fields: [convertedBookingId], references: [id], onDelete: SetNull)
  history          LeadStatusHistory[]

  @@index([propertyId])
  @@index([userId])
  @@index([propertyId, status, expiresAt])
  @@map("quote_requests")
}

model Booking {
  id            String            @id @default(uuid())
  bookingRef    String            @unique
  propertyId    String
  userId        String
  productId     String?
  bookingType   BookingType       @default(SINGLE_TARGET)
  source        BookingSource     @default(PUBLIC)
  targetType    BookingTargetType
  unitId        String?
  roomId        String?
  guestCount    Int               @default(1)
  comfortOption ComfortOption

  guestNameSnapshot    String
  guestEmailSnapshot   String
  guestContactSnapshot String?
  targetLabel          String
  productName          String
  pricePerNight        Decimal

  checkIn                   DateTime
  checkOut                  DateTime
  status                    BookingStatus        @default(PENDING)
  version                   Int                  @default(1)
  checkedInAt               DateTime?
  checkedOutAt              DateTime?
  noShowAt                  DateTime?
  identityVerifiedAt        DateTime?
  identityDocumentType      String?              @db.VarChar(50)
  identityDocumentReference String?              @db.VarChar(100)
  subtotalAmount            Decimal              @default(0)
  taxableAmount             Decimal              @default(0)
  taxAmount                 Decimal              @default(0)
  taxBreakdown              Json?
  totalAmount               Decimal
  paymentStatus             BookingPaymentStatus @default(PENDING)
  paymentPolicy             BookingPaymentPolicy @default(TOKEN_AT_BOOKING)
  upfrontAmount             Decimal              @default(10)
  paymentExpiresAt          DateTime?
  policySnapshot            Json?
  couponId                  String?
  discountAmount            Decimal              @default(0)
  internalNotes             String?              @db.Text
  cancellationReason        String?              @db.Text
  companyId                 String?
  bookingGroupId            String?
  recipientLegalName        String?
  recipientGstin            String?              @db.VarChar(32)
  billingAddressSnapshot    String?              @db.Text
  placeOfSupplyStateCode    String?              @db.VarChar(2)
  cancelledAt               DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  property           Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user               User                    @relation(fields: [userId], references: [id], map: "fk_booking_user")
  coupon             Coupon?                 @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items              BookingItem[]
  payments           Payment[]
  refunds            PaymentRefund[]
  refundRequests     BookingRefundRequest[]
  statusHistory      BookingStatusHistory[]
  operationEvents    BookingOperationEvent[]
  folioCharges       BookingFolioCharge[]
  housekeepingEvents RoomHousekeepingEvent[]
  inventoryLocks     InventoryLock[]
  billingDocuments   BillingDocument[]
  roomAllocations    BookingRoomAllocation[]
  company            CompanyAccount?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  bookingGroup       BookingGroup?           @relation(fields: [bookingGroupId], references: [id], onDelete: SetNull)
  convertedQuote     QuoteRequest?           @relation("QuoteConvertedBooking")

  @@index([propertyId])
  @@index([userId])
  @@index([bookingRef])
  @@index([roomId, checkIn, checkOut])
  @@index([unitId, checkIn, checkOut])
  @@index([status, checkIn, checkOut])
  @@index([status, paymentExpiresAt])
  @@index([propertyId, checkedInAt])
  @@index([propertyId, checkedOutAt])
  @@index([companyId, createdAt])
  @@index([bookingGroupId, checkIn, checkOut])
  @@map("bookings")
}

