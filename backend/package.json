{
  "name": "esm-prisma",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "serve:e2e": "tsx src/server.ts",
    "prepare:e2e": "tsx e2e/prepare.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm run build",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "tsx prisma/seed.ts",
    "pretest:e2e": "npm run prepare:e2e",
    "test:e2e": "playwright test -c playwright.config.ts",
    "pretest:e2e:headed": "npm run prepare:e2e",
    "test:e2e:headed": "playwright test -c playwright.config.ts --headed",
    "pretest:browser": "tsx e2e/prepare-browser.ts",
    "test:browser": "playwright test -c playwright.browser.config.ts",
    "pretest:browser:headed": "tsx e2e/prepare-browser.ts",
    "test:browser:headed": "playwright test -c playwright.browser.config.ts --headed",
    "test:unit": "tsx --test src/common/middleware/browser-origin.middleware.test.ts src/common/middleware/rate-limit.middleware.test.ts src/common/utils/business-date.test.ts src/config/database-url.test.ts src/modules/accounting/accounting.accounts.test.ts src/modules/billing/billing.financials.test.ts src/modules/billing/billing.schema.test.ts src/modules/booking-policy/booking-policy.validation.test.ts src/modules/bookings/bookings.lifecycle.test.ts src/modules/commercial/commercial.financials.test.ts src/modules/notifications/providers/email.provider.test.ts src/modules/payments/providers/payment-gateway.adapter.test.ts src/modules/reporting/reporting.schema.test.ts src/modules/users/users.schema.test.ts",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "backfill:accounting": "tsx scripts/backfill-accounting-ledger.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.2.3",
    "@types/nodemailer": "^7.0.9",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "prettier": "^3.7.4",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1058.0",
    "@prisma/adapter-mariadb": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.16.0",
    "nodemailer": "^7.0.13",
    "playwright": "^1.60.0",
    "prisma": "^7.2.0",
    "zod": "^4.3.4"
  }
}
